// -- RENPHO BODY COMPOSITION --
var RK = 'wt8_renpho';

function loadRenpho() {
  var r = lsGet(RK);
  return r ? JSON.parse(r) : [];
}
function saveRenpho(entries) {
  lsSet(RK, JSON.stringify(entries));
}

function saveBodyMetrics() {
  var date = el('rdate').value;
  if (!date) { showToast('Please select a date'); return; }
  var fields = ['weight','fat','muscle','visceral','bmr','bmi'];
  var entry = {date: date};
  var hasData = false;
  fields.forEach(function(f) {
    var inp = el('r-' + f);
    var v = inp ? inp.value.trim() : '';
    if (v !== '') { entry[f] = parseFloat(v); hasData = true; }
  });
  if (!hasData) { showToast('Enter at least one metric'); return; }
  var entries = loadRenpho();
  entries = entries.filter(function(e) { return e.date !== date; });
  entries.push(entry);
  entries.sort(function(a,b) { return new Date(b.date) - new Date(a.date); });
  saveRenpho(entries);
  ['weight','fat','muscle','visceral','bmr','bmi'].forEach(function(f) {
    var inp = el('r-' + f); if (inp) inp.value = '';
  });
  renderRenphoHistory();
  showBanner('Body metrics saved - ' + fmtDate(date));
}

function renderRenphoHistory() {
  var rh = el('r-history');
  if (!rh) return;
  var entries = loadRenpho();
  if (!entries.length) {
    rh.innerHTML = '<div class="r-empty">No entries yet. Log your first measurement above.</div>';
    return;
  }
  rh.innerHTML = '';
  entries.slice(0, 30).forEach(function(e, idx) {
    var card = document.createElement('div');
    card.className = 'r-card';
    var head = document.createElement('div');
    head.className = 'r-head';
    var dateDiv = document.createElement('div');
    dateDiv.className = 'r-date';
    dateDiv.textContent = fmtDate(e.date);
    var delBtn = document.createElement('button');
    delBtn.className = 'r-del';
    delBtn.textContent = 'Delete';
    delBtn.setAttribute('data-date', e.date);
    delBtn.addEventListener('click', function() {
      var d = this.getAttribute('data-date');
      var ents = loadRenpho().filter(function(x) { return x.date !== d; });
      saveRenpho(ents);
      renderRenphoHistory();
      showToast('Entry deleted');
    });
    head.appendChild(dateDiv);
    head.appendChild(delBtn);
    card.appendChild(head);
    var metrics = document.createElement('div');
    metrics.className = 'r-metrics';
    var defs = [
      {key:'weight', label:'Weight', unit:'lbs', hi: false},
      {key:'fat',    label:'Body Fat', unit:'%',  warn: true},
      {key:'muscle', label:'Muscle',   unit:'%',  hi: true},
      {key:'visceral',label:'Visceral',unit:'lvl',warn: true},
      {key:'bmr',    label:'BMR',      unit:'kcal',hi: false},
      {key:'bmi',    label:'BMI',      unit:'',   hi: false}
    ];
    defs.forEach(function(def) {
      if (e[def.key] === undefined) return;
      var m = document.createElement('div');
      m.className = 'r-metric';
      var valCls = def.hi ? 'r-val r-val-hi' : (def.warn ? 'r-val r-val-warn' : 'r-val');
      m.innerHTML = '<div class="' + valCls + '">' + e[def.key] + (def.unit ? '<span style="font-size:10px;font-weight:400;color:#5C6478;"> ' + def.unit + '</span>' : '') + '</div>' +
        '<div class="r-lbl">' + def.label + '</div>';
      metrics.appendChild(m);
    });
    card.appendChild(metrics);
    rh.innerHTML = '';
    entries.slice(0, 30).forEach(function(e2) { rh.appendChild(buildRCard(e2)); });
  });
}

function buildRCard(e) {
  var card = document.createElement('div');
  card.className = 'r-card';
  var head = document.createElement('div');
  head.className = 'r-head';
  var dateDiv = document.createElement('div');
  dateDiv.className = 'r-date';
  dateDiv.textContent = fmtDate(e.date);
  var delBtn = document.createElement('button');
  delBtn.className = 'r-del';
  delBtn.textContent = 'Delete';
  delBtn.setAttribute('data-date', e.date);
  delBtn.addEventListener('click', function() {
    var d = this.getAttribute('data-date');
    var ents = loadRenpho().filter(function(x) { return x.date !== d; });
    saveRenpho(ents);
    renderRenphoHistory();
    showToast('Entry deleted');
  });
  head.appendChild(dateDiv);
  head.appendChild(delBtn);
  card.appendChild(head);
  var metrics = document.createElement('div');
  metrics.className = 'r-metrics';
  var defs = [
    {key:'weight', label:'Weight',   unit:'lbs', cls:'r-val'},
    {key:'fat',    label:'Body Fat', unit:'%',   cls:'r-val r-val-warn'},
    {key:'muscle', label:'Muscle',   unit:'%',   cls:'r-val r-val-hi'},
    {key:'visceral',label:'Visceral',unit:'lvl', cls:'r-val r-val-warn'},
    {key:'bmr',    label:'BMR',      unit:'kcal',cls:'r-val'},
    {key:'bmi',    label:'BMI',      unit:'',    cls:'r-val'}
  ];
  defs.forEach(function(def) {
    if (e[def.key] === undefined) return;
    var m = document.createElement('div');
    m.className = 'r-metric';
    m.innerHTML = '<div class="' + def.cls + '">' + e[def.key] +
      (def.unit ? '<span style="font-size:10px;font-weight:400;color:#5C6478;"> ' + def.unit + '</span>' : '') +
      '</div><div class="r-lbl">' + def.label + '</div>';
    metrics.appendChild(m);
  });
  card.appendChild(metrics);
  return card;
}


// -- INIT ------------------------------------------------------------------
el('wdate').value = new Date().toISOString().split('T')[0];
  el('rdate').value = new Date().toISOString().split('T')[0];
loadData();
renderLog();


})();
</script>
