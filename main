// -- STATE -----------------------------------------------------------------
var curDay = 'A';
var workouts = [];
var checked = {};
var hFilter = 'all';
var editIdx = -1;

// -- STORAGE ---------------------------------------------------------------
var WK = 'wt8_workouts';
var CK_PREFIX = 'wt8_chk_';

function todayKey() {
  return CK_PREFIX + new Date().toISOString().split('T')[0];
}

function lsGet(k) {
  try { return localStorage.getItem(k); } catch(e) { return null; }
}
function lsSet(k, v) {
  try { localStorage.setItem(k, v); return true; } catch(e) { return false; }
}
function lsRemove(k) {
  try { localStorage.removeItem(k); } catch(e) {}
}
function lsKeys() {
  try {
    var keys = [];
    for (var i = 0; i < localStorage.length; i++) { keys.push(localStorage.key(i)); }
    return keys;
  } catch(e) { return []; }
}

function loadData() {
  var w = lsGet(WK);
  workouts = w ? JSON.parse(w) : [];
  var c = lsGet(todayKey());
  checked = c ? JSON.parse(c) : {};
  // Clean old check keys
  var tk = todayKey();
  lsKeys().forEach(function(k) {
    if (k.indexOf(CK_PREFIX) === 0 && k !== tk) lsRemove(k);
  });
}

function saveData() {
  lsSet(WK, JSON.stringify(workouts));
}

function saveChecks() {
  lsSet(todayKey(), JSON.stringify(checked));
}

// -- RENDERING HELPERS -----------------------------------------------------
function el(id) { return document.getElementById(id); }

function makeCB(item, isStretch) {
  var div = document.createElement('div');
  div.className = 'cb' + (checked[item.id] ? ' done' : '');
  div.id = 'cb-' + item.id;
  div.setAttribute('data-id', item.id);
  div.innerHTML = '<div class="cb-row">' +
    '<div class="cb-circle"><span class="cb-tick">&#10003;</span></div>' +
    '<div class="cb-lbl">' +
    '<div class="cb-name">' + (item.target ? '<span class="str-tag">' + item.target + '</span>' : '') + item.name + '</div>' +
    '<div class="cb-hint">' + (item.hint || item.desc || '') + '</div>' +
    '<div class="cb-time">&#9201; ' + (item.time || '') + '</div>' +
    '</div></div>';
  if (item.vid) {
    var vb = document.createElement('button');
    vb.className = 'vidbtn';
    vb.textContent = '&#9654; Watch video';
    vb.setAttribute('data-vid', item.vid);
    div.querySelector('.cb-lbl').appendChild(vb);
    vb.addEventListener('click', function(e) {
      e.stopPropagation();
      openVid(this.getAttribute('data-vid'));
    });
  }
  div.addEventListener('click', function() { toggle(this.getAttribute('data-id')); });
  return div;
}

function makeExBlock(ex) {
  var div = document.createElement('div');
  div.className = 'ex-block';

  var top = document.createElement('div');
  top.className = 'ex-top';

  var nr = document.createElement('div');
  nr.className = 'ex-nr';
  var nameDiv = document.createElement('div');
  nameDiv.className = 'ex-name';
  nameDiv.textContent = ex.name;
  nr.appendChild(nameDiv);
  if (ex.note) {
    var tagDiv = document.createElement('div');
    tagDiv.className = 'ex-tag';
    tagDiv.textContent = ex.note;
    nr.appendChild(tagDiv);
  }
  top.appendChild(nr);

  var meta = document.createElement('div');
  meta.className = 'ex-meta';
  if (ex.timed) {
    var tb = document.createElement('span');
    tb.className = 'ex-timed';
    tb.textContent = '&#9201; ' + ex.sets + ' sets - log seconds';
    meta.appendChild(tb);
  } else {
    var uniq = [];
    ex.reps.forEach(function(r) { if (r > 0 && uniq.indexOf(r) < 0) uniq.push(r); });
    if (uniq.length) {
      var rb = document.createElement('span');
      rb.className = 'ex-reps';
      rb.textContent = ex.sets + 'x' + uniq.join('/') + ' reps';
      meta.appendChild(rb);
    }
  }
  if (ex.vid) {
    var vb = document.createElement('button');
    vb.className = 'vidbtn';
    vb.textContent = '&#9654; Watch video';
    vb.setAttribute('data-vid', ex.vid);
    vb.addEventListener('click', function() { openVid(this.getAttribute('data-vid')); });
    meta.appendChild(vb);
  }
  top.appendChild(meta);
  div.appendChild(top);

  var gc = ex.sets === 2 ? 'sg sg2' : 'sg sg3';
  var sg = document.createElement('div');
  sg.className = gc;
  var unit = ex.unit || 'total';
  for (var i = 0; i < ex.sets; i++) {
    var si = document.createElement('div');
    si.className = 'si';
    var lbl = document.createElement('label');
    if (ex.timed) {
      lbl.textContent = 'Set ' + (i+1) + ' (sec)';
    } else if (unit === 'reps') {
      lbl.textContent = 'Set ' + (i+1) + ' (reps)';
    } else {
      lbl.textContent = ex.reps[i] > 0 ? 'Set ' + (i+1) + ' - ' + ex.reps[i] + ' reps' : 'Set ' + (i+1);
    }
    var inp = document.createElement('input');
    inp.type = 'number';
    inp.id = ex.id + '_s' + (i+1);
    if (ex.timed) { inp.placeholder = '-'; }
    else if (unit === 'reps') { inp.placeholder = 'reps'; }
    else if (unit === 'each') { inp.placeholder = 'lbs ea'; }
    else { inp.placeholder = 'lbs'; }
    inp.min = '0';
    inp.step = ex.timed ? '5' : (unit === 'reps' ? '1' : '2.5');
    inp.setAttribute('inputmode', 'decimal');
    si.appendChild(lbl);
    si.appendChild(inp);
    sg.appendChild(si);
  }
  div.appendChild(sg);

  var nr2 = document.createElement('div');
  nr2.className = 'nr';
  var nl = document.createElement('label');
  nl.textContent = 'Notes';
  var ni = document.createElement('input');
  ni.type = 'text';
  ni.id = ex.id + '_note';
  ni.placeholder = ex.timed ? 'e.g. completed all sets, felt stable' : 'e.g. felt easy, go up next time';
  nr2.appendChild(nl);
  nr2.appendChild(ni);
  div.appendChild(nr2);

  return div;
}

// -- RENDER LOG ------------------------------------------------------------
function renderLog() {
  var day = D[curDay];
  var lb = el('log-body');
  lb.innerHTML = '';

  function addSH(label, cls) {
    var sh = document.createElement('div');
    sh.className = 'sh ' + cls;
    sh.textContent = label;
    lb.appendChild(sh);
  }

  addSH('Warm-Up', 'sh-w');
  day.warmup.forEach(function(it) { lb.appendChild(makeCB(it, false)); });

  addSH('Main Workout', 'sh-m');
  day.exercises.forEach(function(ex) { lb.appendChild(makeExBlock(ex)); });

  addSH('Post-Workout Stretches', 'sh-s');
  var hint = document.createElement('p');
  hint.style.cssText = 'font-size:12px;color:#5C6478;margin-bottom:9px;';
  hint.textContent = 'Core 5 every session + Day ' + curDay + ' additions.';
  lb.appendChild(hint);
  CS.forEach(function(s) { lb.appendChild(makeCB(s, true)); });
  day.stretches.forEach(function(s) { lb.appendChild(makeCB(s, true)); });

  addSH('Cool-Down', 'sh-c');
  day.cooldown.forEach(function(it) { lb.appendChild(makeCB(it, false)); });
}

// -- TOGGLE CHECK ----------------------------------------------------------
function toggle(id) {
  checked[id] = !checked[id];
  ['cb-', 'sc-'].forEach(function(prefix) {
    var cel = el(prefix + id);
    if (cel) {
      if (checked[id]) cel.classList.add('done');
      else cel.classList.remove('done');
    }
  });
  saveChecks();
  updateProgress();
}

// -- SAVE WORKOUT ----------------------------------------------------------
function saveWorkout() {
  var date = el('wdate').value;
  if (!date) { showToast('Please select a date'); return; }
  var day = D[curDay];
  var entries = [];
  var hasData = false;
  day.exercises.forEach(function(ex) {
    var sets = [];
    for (var i = 1; i <= ex.sets; i++) {
      var inp = el(ex.id + '_s' + i);
      var v = inp ? inp.value.trim() : '';
      sets.push(v !== '' ? parseFloat(v) : null);
      if (v !== '') hasData = true;
    }
    var noteInp = el(ex.id + '_note');
    var noteVal = noteInp ? noteInp.value : '';
    if (ex.timed && noteVal.trim() !== '') hasData = true;
    entries.push({id:ex.id, name:ex.name, reps:ex.reps, sets:sets, note:noteVal, timed:ex.timed, unit:ex.unit || 'total'});
  });
  if (!hasData) { showToast('Enter at least one value'); return; }
  workouts = workouts.filter(function(w) { return !(w.date === date && w.day === curDay); });
  workouts.push({date:date, day:curDay, dayLabel:day.label, entries:entries, savedAt:new Date().toISOString()});
  workouts.sort(function(a,b) { return new Date(b.date) - new Date(a.date); });
  saveData();
  var verify = lsGet(WK);
  if (verify && JSON.parse(verify).length > 0) {
    showBanner('Workout saved - ' + fmtDate(date) + ' - Check History tab');
  } else {
    showToast('Save may have failed - export JSON as backup');
  }
  day.exercises.forEach(function(ex) {
    for (var i = 1; i <= ex.sets; i++) {
      var inp = el(ex.id + '_s' + i);
      if (inp) inp.value = '';
    }
    var noteInp = el(ex.id + '_note');
    if (noteInp) noteInp.value = '';
  });
}

// -- STRETCH TAB -----------------------------------------------------------
function renderStretch() {
  var sc = el('s-core');
  var sd = el('s-day');
  var sl = el('s-day-lbl');
  sc.innerHTML = '';
  sd.innerHTML = '';
  sl.textContent = 'Day ' + curDay + ' Additions';
  CS.forEach(function(s) { sc.appendChild(makeStrTab(s)); });
  D[curDay].stretches.forEach(function(s) { sd.appendChild(makeStrTab(s)); });
  updateProgress();
}

function makeStrTab(s) {
  var div = document.createElement('div');
  div.className = 'cb' + (checked[s.id] ? ' done' : '');
  div.id = 'sc-' + s.id;
  div.setAttribute('data-id', s.id);
  var tagHTML = s.target ? '<div style="display:inline-block;font-size:10px;font-weight:600;text-transform:uppercase;color:#4ECDC4;background:rgba(78,205,196,0.12);padding:1px 7px;border-radius:4px;margin-bottom:4px;">' + s.target + '</div>' : '';
  div.innerHTML = '<div class="cb-row">' +
    '<div class="cb-circle"><span class="cb-tick">&#10003;</span></div>' +
    '<div class="cb-lbl">' + tagHTML +
    '<div class="cb-name">' + s.name + '</div>' +
    '<div class="cb-hint">' + (s.desc || s.hint || '') + '</div>' +
    '<div class="cb-time">&#9201; ' + (s.time || '') + '</div>' +
    '</div></div>';
  if (s.vid) {
    var vb = document.createElement('button');
    vb.className = 'vidbtn';
    vb.textContent = '&#9654; Watch video';
    vb.setAttribute('data-vid', s.vid);
    div.querySelector('.cb-lbl').appendChild(vb);
    vb.addEventListener('click', function(e) {
      e.stopPropagation();
      openVid(this.getAttribute('data-vid'));
    });
  }
  div.addEventListener('click', function() { toggle(this.getAttribute('data-id')); });
  return div;
}

function updateProgress() {
  var all = CS.concat(D[curDay].stretches);
  var total = all.length;
  var done = all.filter(function(s) { return !!checked[s.id]; }).length;
  var spn = el('sp-n');
  var spf = el('sp-fill');
  var spl = el('sp-lbl');
  if (spn) spn.textContent = done;
  if (spl) spl.textContent = 'of ' + total + ' done';
  if (spf) spf.style.width = total ? (done/total*100) + '%' : '0%';
}

function resetStretches() {
  checked = {};
  saveChecks();
  renderStretch();
  if (el('tab-log').classList.contains('on')) renderLog();
}

// -- HISTORY ---------------------------------------------------------------
function renderHistory() {
  renderProgTips();
  var list = hFilter === 'all' ? workouts : workouts.filter(function(w) { return w.day === hFilter; });
  var hl = el('hlist');
  if (!list.length) {
    hl.innerHTML = '<div class="empty-state"><div class="big">&#128203;</div><p>No workouts yet.<br>Log one and tap Save.<br><br>Have old data? Import JSON in Export tab.</p></div>';
    return;
  }
  hl.innerHTML = '';
  list.forEach(function(w) {
    var idx = workouts.indexOf(w);
    var card = document.createElement('div');
    card.className = 'hcard';
    var head = document.createElement('div');
    head.className = 'hhead';
    head.innerHTML = '<div><div class="hday">Day ' + w.day + '</div><div class="hdate">' + fmtDate(w.date) + '</div></div>';
    var btns = document.createElement('div');
    btns.className = 'hbtns';
    var eb = document.createElement('button');
    eb.className = 'edb';
    eb.textContent = 'Edit';
    eb.setAttribute('data-idx', idx);
    eb.addEventListener('click', function() { openEdit(parseInt(this.getAttribute('data-idx'))); });
    var db = document.createElement('button');
    db.className = 'dlb';
    db.textContent = 'Delete';
    db.setAttribute('data-idx', idx);
    db.addEventListener('click', function() { delW(parseInt(this.getAttribute('data-idx'))); });
    btns.appendChild(eb);
    btns.appendChild(db);
    head.appendChild(btns);
    card.appendChild(head);
    var rows = document.createElement('div');
    rows.className = 'hrows';
    var hasRows = false;
    w.entries.forEach(function(e) {
      var hasVals = e.sets.some(function(s) { return s !== null; }) || e.note;
      if (!hasVals) return;
      hasRows = true;
      var eu = e.unit || 'total';
      var unit = e.timed ? 'sec' : (eu === 'reps' ? 'reps' : (eu === 'each' ? 'lb ea' : 'lb'));
      var sStr = e.sets.map(function(v, i) {
        if (v === null) return '';
        var rep = (!e.timed && eu !== 'reps' && e.reps && e.reps[i] > 0) ? 'x' + e.reps[i] : '';
        return 'S' + (i+1) + ':' + v + unit + rep;
      }).filter(Boolean).join('   ');
      var row = document.createElement('div');
      row.className = 'hrow';
      row.innerHTML = '<div class="hex">' + e.name + '</div><div class="hsets">' + (sStr || '-') + '</div>' + (e.note ? '<div class="hnote">&#128172; ' + e.note + '</div>' : '');
      rows.appendChild(row);
    });
    if (!hasRows) rows.innerHTML = '<div style="font-size:12px;color:#5C6478;padding:6px 0">No values recorded</div>';
    card.appendChild(rows);
    hl.appendChild(card);
  });
}

function renderProgTips() {
  var pt = el('prog-tips');
  if (!pt) return;
  if (workouts.length < 2) { pt.innerHTML = '<p class="prog-empty">Keep logging - tips appear once you have 3+ sessions per exercise.</p>'; return; }
  var byEx = {};
  workouts.forEach(function(w) {
    w.entries.forEach(function(e) {
      if (!byEx[e.id]) byEx[e.id] = {name:e.name, day:w.day, unit:e.unit || 'total', sessions:[]};
      var wts = e.sets.filter(function(s) { return s !== null; });
      if (wts.length) byEx[e.id].sessions.push({date:w.date, wts:wts, note:e.note || ''});
    });
  });
  var tips = [];
  Object.keys(byEx).forEach(function(key) {
    var ex = byEx[key];
    var isReps = ex.unit === 'reps';
    var unitLbl = isReps ? 'reps' : (ex.unit === 'each' ? 'lbs ea' : 'lbs');
    var ss = ex.sessions.slice().sort(function(a,b) { return new Date(a.date) - new Date(b.date); });
    if (!ss.length) return;
    var latW = Math.max.apply(null, ss[ss.length-1].wts);
    var atSame = ss.filter(function(s) { return Math.max.apply(null, s.wts) === latW; });
    if (atSame.length >= 3) {
      var inc = isReps ? 2 : (latW <= 45 ? 2.5 : 5);
      tips.push({name:ex.name, day:ex.day, msg:atSame.length + ' sessions at ' + latW + ' ' + unitLbl, action:'Try ' + (latW+inc) + ' ' + unitLbl + ' next session', type:'r'});
    } else {
      var flagged = ss.slice(-2).filter(function(s) {
        var n = s.note.toLowerCase();
        return n.indexOf('easy') >= 0 || n.indexOf('increase') >= 0 || n.indexOf('too light') >= 0;
      });
      if (flagged.length) {
        var inc2 = isReps ? 2 : (latW <= 45 ? 2.5 : 5);
        tips.push({name:ex.name, day:ex.day, msg:'Notes say it felt easy at ' + latW + ' ' + unitLbl, action:'Consider ' + (latW+inc2) + ' ' + unitLbl + ' next session', type:'y'});
      }
    }
  });
  if (!tips.length) { pt.innerHTML = '<p class="prog-empty">No progression flags yet. Keep logging consistently.</p>'; return; }
  pt.innerHTML = tips.map(function(t) {
    return '<div class="ptip ptip-' + t.type + '">' +
      '<div class="ptip-label ptip-l' + t.type + '">Day ' + t.day + ' - ' + t.name + '</div>' +
      '<div class="ptip-msg">' + t.msg + '</div>' +
      '<div class="ptip-action ptip-a' + t.type + '">&#8594; ' + t.action + '</div>' +
    '</div>';
  }).join('');
}

function delW(idx) {
  if (!confirm('Delete this workout?')) return;
  workouts.splice(idx, 1);
  saveData();
  renderHistory();
  renderStats();
  showToast('Deleted');
}

// -- EDIT MODAL ------------------------------------------------------------
function openEdit(idx) {
  editIdx = idx;
  var w = workouts[idx];
  el('modal-title').textContent = 'Edit - Day ' + w.day + ' - ' + fmtDate(w.date);
  var mb = el('modal-body');
  mb.innerHTML = '';
  w.entries.forEach(function(e) {
    var mex = document.createElement('div');
    mex.className = 'mex';
    var mn = document.createElement('div');
    mn.className = 'mex-name';
    mn.textContent = e.name;
    mex.appendChild(mn);
    var gc = e.sets.length === 2 ? 'msg msg2' : 'msg msg3';
    var msg = document.createElement('div');
    msg.className = gc;
    var eu = e.unit || 'total';
    e.sets.forEach(function(v, i) {
      var si = document.createElement('div');
      var lbl = document.createElement('label');
      if (e.timed) {
        lbl.textContent = 'Set ' + (i+1) + ' (sec)';
      } else if (eu === 'reps') {
        lbl.textContent = 'Set ' + (i+1) + ' (reps)';
      } else {
        lbl.textContent = 'Set ' + (i+1) + (e.reps && e.reps[i] > 0 ? ' - ' + e.reps[i] + 'r' : '');
      }
      var inp = document.createElement('input');
      inp.type = 'number';
      inp.id = 'edit_' + e.id + '_s' + (i+1);
      inp.value = v !== null ? v : '';
      if (e.timed) { inp.placeholder = 'sec'; }
      else if (eu === 'reps') { inp.placeholder = 'reps'; }
      else if (eu === 'each') { inp.placeholder = 'lbs ea'; }
      else { inp.placeholder = 'lbs'; }
      inp.min = '0';
      inp.step = e.timed ? '5' : (eu === 'reps' ? '1' : '2.5');
      inp.setAttribute('inputmode', 'decimal');
      si.appendChild(lbl);
      si.appendChild(inp);
      msg.appendChild(si);
    });
    mex.appendChild(msg);
    var mnr = document.createElement('div');
    mnr.className = 'mnr';
    var ml = document.createElement('label');
    ml.textContent = 'Notes';
    var mi = document.createElement('input');
    mi.type = 'text';
    mi.id = 'edit_' + e.id + '_note';
    mi.value = e.note || '';
    mnr.appendChild(ml);
    mnr.appendChild(mi);
    mex.appendChild(mnr);
    mb.appendChild(mex);
  });
  el('modal-ov').classList.add('open');
}

function closeModal() { el('modal-ov').classList.remove('open'); editIdx = -1; }

function saveEdit() {
  if (editIdx < 0) return;
  var w = workouts[editIdx];
  w.entries.forEach(function(e) {
    e.sets = e.sets.map(function(_, i) {
      var inp = el('edit_' + e.id + '_s' + (i+1));
      var v = inp ? inp.value.trim() : '';
      return v !== '' ? parseFloat(v) : null;
    });
    var ni = el('edit_' + e.id + '_note');
    if (ni) e.note = ni.value;
  });
  saveData();
  closeModal();
  renderHistory();
  showToast('Changes saved!');
}

// -- EXPORT ----------------------------------------------------------------
function renderStats() {
  var sc = el('stat-cards');
  if (!sc) return;
  var n = workouts.length;
  var a = workouts.filter(function(w) { return w.day === 'A'; }).length;
  var b = workouts.filter(function(w) { return w.day === 'B'; }).length;
  var c = workouts.filter(function(w) { return w.day === 'C'; }).length;
  var d = workouts.filter(function(w) { return w.day === 'D'; }).length;
  var first = n ? fmtDate(workouts[n-1].date) : '-';
  sc.innerHTML = '<div class="stat-card"><div class="sn">' + n + '</div><div class="sl">Total sessions</div></div>' +
    '<div class="stat-card"><div class="sn">' + a + ' ' + b + ' ' + c + ' ' + d + '</div><div class="sl">A   B   C   D</div></div>' +
    '<div class="stat-card" style="grid-column:1/-1"><div class="sn" style="font-size:14px;">' + first + '</div><div class="sl">First workout logged</div></div>';
}

function buildText() {
  if (!workouts.length) return 'No workouts logged yet.';
  var nl = '\n';
  var out = '=== WORKOUT LOG ===' + nl + nl + 'Sessions: ' + workouts.length + nl + nl;
  var byEx = {};
  workouts.forEach(function(w) {
    w.entries.forEach(function(e) {
      if (!byEx[e.name]) byEx[e.name] = [];
      var wts = e.sets.filter(function(s) { return s !== null; });
      if (wts.length) byEx[e.name].push({date:w.date, day:w.day, wts:wts, timed:e.timed, unit:e.unit || 'total', note:e.note});
    });
  });
  Object.keys(byEx).forEach(function(name) {
    out += name + ':' + nl;
    byEx[name].sort(function(a,b) { return new Date(a.date)-new Date(b.date); }).forEach(function(s) {
      var u = s.timed ? 'sec' : (s.unit === 'reps' ? 'reps' : (s.unit === 'each' ? 'lbs ea' : 'lbs'));
      out += '  ' + s.date + ' (Day ' + s.day + '): ' + s.wts.join('/') + u + (s.note ? ' | ' + s.note : '') + nl;
    });
    out += nl;
  });
  return out;
}

function expText() {
  var t = buildText();
  el('copy-area').textContent = t;
  el('copy-area').classList.add('show');
  navigator.clipboard.writeText(t).then(function() { showToast('Copied!'); }).catch(function() { showToast('See text below'); });
}

function expJSON() {
  var j = JSON.stringify(workouts, null, 2);
  el('copy-area').textContent = j;
  el('copy-area').classList.add('show');
  navigator.clipboard.writeText(j).then(function() { showToast('JSON copied!'); }).catch(function() {});
}

function expCSV() {
  var nl = '\n';
  var csv = 'Date,Day,Exercise,Set1,Set2,Set3,Unit,Notes' + nl;
  workouts.forEach(function(w) {
    w.entries.forEach(function(e) {
      var eu = e.unit || 'total';
      var unit = e.timed ? 'sec' : (eu === 'reps' ? 'reps' : (eu === 'each' ? 'lbs-ea' : 'lbs'));
      csv += w.date + ',Day ' + w.day + ',"' + e.name + '",' +
        e.sets.map(function(s) { return s !== null ? s : ''; }).join(',') + ',' +
        unit + ',"' + (e.note || '').replace(/,/g, ';') + '"' + nl;
    });
  });
  var a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob([csv], {type:'text/csv'}));
  a.download = 'workouts_' + new Date().toISOString().split('T')[0] + '.csv';
  a.click();
  showToast('CSV downloaded!');
}

function impJSON() {
  var raw = el('imp-area').value.trim();
  if (!raw) { showToast('Paste JSON first'); return; }
  try {
    var parsed = JSON.parse(raw);
    if (!Array.isArray(parsed)) { showToast('Invalid format'); return; }
    var added = 0;
    parsed.forEach(function(w) {
      var exists = workouts.some(function(x) { return x.date === w.date && x.day === w.day; });
      if (!exists) { workouts.push(w); added++; }
    });
    workouts.sort(function(a,b) { return new Date(b.date) - new Date(a.date); });
    saveData();
    renderHistory();
    renderStats();
    el('imp-area').value = '';
    showToast('Imported ' + added + ' workout' + (added !== 1 ? 's' : ''));
  } catch(e) { showToast('Invalid JSON - check format'); }
}

// -- NAV -------------------------------------------------------------------
function showTab(tabId) {
  ['log','stretch','history','export','renpho'].forEach(function(t) {
    el('tab-' + t).classList.remove('on');
    el('t-' + t).classList.remove('on');
  });
  el('tab-' + tabId).classList.add('on');
  el('t-' + tabId).classList.add('on');
  if (tabId === 'history') renderHistory();
  if (tabId === 'export') renderStats();
  if (tabId === 'renpho') { el('rdate').value = new Date().toISOString().split('T')[0]; renderRenphoHistory(); }
  if (tabId === 'stretch') renderStretch();
}

function openVid(url) {
  var w = null;
  try { w = window.open(url, '_blank'); } catch(e) {}
  if (!w) { try { window.location.href = url; } catch(e) {} }
}

function fmtDate(ds) {
  return new Date(ds + 'T12:00:00').toLocaleDateString('en-US', {weekday:'short', month:'short', day:'numeric', year:'numeric'});
}

function showToast(msg) {
  var t = el('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(function() { t.classList.remove('show'); }, 2400);
}

function showBanner(msg) {
  var b = el('save-banner');
  b.textContent = msg;
  b.classList.add('show');
  setTimeout(function() { b.classList.remove('show'); }, 3500);
}

